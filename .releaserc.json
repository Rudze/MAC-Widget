{
  "branches": ["main"],
  "plugins": [
    ["@semantic-release/commit-analyzer", { "preset": "conventionalcommits" }],
    ["@semantic-release/release-notes-generator", { "preset": "conventionalcommits" }],
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/exec", {
      "prepareCmd": "sed -i 's|<key>CFBundleShortVersionString</key><string>[^<]*</string>|<key>CFBundleShortVersionString</key><string>${nextRelease.version}</string>|' Resources/App-Info.plist Resources/Widgets-Info.plist"
    }],
    ["@semantic-release/git", {
      "assets": ["CHANGELOG.md", "Resources/App-Info.plist", "Resources/Widgets-Info.plist"],
      "message": "chore(release): ${nextRelease.version}\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", { "successComment": false, "failComment": false }]
  ]
}
